# Public API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Canonical site URL used for OG / share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match server GOOGLE_CLIENT_ID when Google login is enabled
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional footer social links (https URLs only; empty = hidden)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
